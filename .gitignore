# Exceção: as migrações do Drizzle são versionadas
!drizzle/*.sql
# Exceção: o schema completo usado por scripts/criar-banco.mjs. É só DDL,
# gerado do drizzle/schema.ts, sem uma linha de dado.
!scripts/schema-completo.sql

