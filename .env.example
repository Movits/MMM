# Copie para .env e preencha. NUNCA commite o .env preenchido.

# Ambiente de execução: "production" ativa o modo produção
NODE_ENV=
# Porta do servidor HTTP (padrão 3000)
PORT=
# Origem pública do site, usada em links de e-mail e redirects
FRONTEND_URL=

# Banco de dados
# String de conexão MySQL (mysql://usuario:senha@host:porta/banco)
DATABASE_URL=

# Autenticação
# Identificador do app gravado no JWT de sessão (claim appId)
VITE_APP_ID=
# Segredo de assinatura dos cookies/JWT
JWT_SECRET=

# Criptografia
# Chave do cofre de credenciais; sem ela cai no JWT_SECRET
VAULT_ENCRYPTION_KEY=

# LLM
# Endpoint compatível com a API da OpenAI. Para o Google Gemini:
# https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_URL=
# Chave do endpoint acima; GOOGLE_API_KEY serve de alternativa
LLM_API_KEY=
GOOGLE_API_KEY=

# Storage de arquivos (uploads, gravações de reunião, documentos)
# API do S3, que é padrão de fato: AWS S3, Cloudflare R2, Backblaze B2 e MinIO
# servem — a decisão D6 escolhe o provedor, o código é o mesmo.
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Só para provedor que não seja a AWS (ex.: https://<conta>.r2.cloudflarestorage.com)
STORAGE_ENDPOINT=
# Padrão: "auto" com STORAGE_ENDPOINT definido; "us-east-1" na AWS
STORAGE_REGION=

# Sobrescreve o modelo padrão das chamadas de LLM
LLM_MODEL=

# E-mail
# Chave da API Resend
RESEND_API_KEY=
# Remetente dos e-mails transacionais ("Nome <endereco>")
EMAIL_FROM=

# Testes
# "true" libera os testes que chamam os provedores reais
RUN_LIVE_CREDENTIAL_TESTS=
